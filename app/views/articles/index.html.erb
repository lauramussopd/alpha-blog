<%# Titolo e bottone "Nuovo Articolo" allineati %>
<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="fw-bold">Lista degli Articoli</h1>
  <%= link_to "Nuovo Articolo", new_article_path, class: "btn btn-primary" %>
</div>

<%# Griglia delle card %>
<div class="row">
  <% @articles.each do |article| %>
    <div class="col-md-4 mb-4">
      <%# Card con ombreggiatura e bordo arrotondato %>
      <div class="card h-100 shadow-sm border-0">
        <div class="card-body">
          <h5 class="card-title fw-bold"><%= article.title %></h5>
          <%# Truncate taglia il testo se troppo lungo, per mantenere le card uniformi %>
          <p class="card-text text-muted"><%= truncate(article.description, length: 120) %></p>
        </div>
        
        <%# Footer della card con i bottoni %>
        <div class="card-footer bg-white border-0 d-flex justify-content-end gap-2 pb-3">
          <%= link_to "Show", article_path(article), class: "btn btn-sm btn-outline-primary" %>
          <%= link_to "Edit", edit_article_path(article), class: "btn btn-sm btn-outline-secondary" %>
          <%= link_to "Delete", article_path(article), 
              data: { turbo_method: :delete, turbo_confirm: "Sei sicuro di voler eliminare questo articolo?" }, 
              class: "btn btn-sm btn-outline-danger" %>
        </div>
      </div>
    </div>
  <% end %>
</div>

<%# Link inferiore %>
<div class="text-center mt-4">
  <%= link_to "Torna alla Home", root_path, class: "btn btn-link text-decoration-none" %>
</div>