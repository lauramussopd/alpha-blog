<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <%# Card principale che contiene l'articolo %>
      <div class="card shadow-sm border-0">
        <div class="card-body p-5">
          
          <h1 class="display-4 fw-bold mb-3"><%= @article.title %></h1>
          
          <%# Data formattata meglio %>
          <p class="text-muted mb-4">
            <i class="bi bi-calendar"></i> Pubblicato il: <%= @article.created_at.strftime("%d %B %Y") %>
          </p>
          
          <hr class="my-4">
          
          <%# Descrizione con spaziatura per la leggibilità %>
          <div class="fs-5 lh-lg text-secondary">
            <%= @article.description %>
          </div>
        </div>

        <%# Footer della card con le azioni %>
        <div class="card-footer bg-white p-4 border-0 d-flex gap-2">
          <%= link_to "Edit", edit_article_path(@article), class: "btn btn-outline-primary" %>
          
          <%= link_to "Delete", article_path(@article), 
              data: { turbo_method: :delete, turbo_confirm: "Sei sicuro?" }, 
              class: "btn btn-outline-danger" %>
              
          <%= link_to "Torna alla lista", articles_path, class: "btn btn-secondary ms-auto" %>
        </div>
      </div>
    </div>
  </div>
</div>